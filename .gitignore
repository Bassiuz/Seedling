# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# FVM Version Cache
.fvm/

# Golden test failure diffs (regenerated on every failing run)
**/test/**/failures/

# Things that must never be committed. The Firebase config files here are
# client identifiers and are meant to ship; these are not.
*.jks
*.keystore
key.properties
*.p8
*.p12
*.pem
*.mobileprovision
.env
.env.*
service-account*.json

# Your Firebase project is yours. `flutterfire configure` writes these; keeping
# them out means a clone fails to build with an obvious reason rather than
# quietly running against somebody else's project.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
app_dev_log.txt
bas_standup_items.md
