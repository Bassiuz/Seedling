<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app writes today here; the widget reads it. Both targets must
	     declare the identical group or the widget sees an empty container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.bassiuz.seedling</string>
	</array>
</dict>
</plist>
