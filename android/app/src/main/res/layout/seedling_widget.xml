                        android:id="@+id/event_time_0"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:textSize="9sp"
                        android:textColor="@color/seedling_muted" />
                    <TextView
                        android:id="@+id/event_title_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="11sp"
                        android:textColor="@color/seedling_ink" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/event_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
