<?xml version="1.0" encoding="utf-8"?>
<!-- Four wide, two high: the day's appointments beside what is left to do.
     RemoteViews cannot loop, so every row exists here and the provider hides
     the ones it does not need. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/seedling_widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/seedling_muted" />

                <LinearLayout
                    android:id="@+id/event_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="3dp">
                    <TextView
                        android:id="@+id/event_time_0"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/seedling_muted" />
                    <TextView
                        android:id="@+id/event_title_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textColor="@color/seedling_ink" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/event_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="3dp">
                    <TextView
                        android:id="@+id/event_time_1"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/seedling_muted" />
                    <TextView
                        android:id="@+id/event_title_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textColor="@color/seedling_ink" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/event_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="3dp">
                    <TextView
                        android:id="@+id/event_time_2"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/seedling_muted" />
                    <TextView
                        android:id="@+id/event_title_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textColor="@color/seedling_ink" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/event_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="3dp">
                    <TextView
                        android:id="@+id/event_time_3"
                        android:layout_width="42dp"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/seedling_muted" />
                    <TextView
                        android:id="@+id/event_title_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textColor="@color/seedling_ink" />
                </LinearLayout>
        <TextView
            android:id="@+id/events_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Nothing scheduled"
            android:textSize="12sp"
            android:textColor="@color/seedling_faint" />
        <TextView
            android:id="@+id/events_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/seedling_faint" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="@color/seedling_rule" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="To do"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/seedling_muted" />

                <LinearLayout
                    android:id="@+id/task_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="3dp">
                    <ImageView
                        android:id="@+id/task_box_0"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:padding="3dp"
                        android:src="@drawable/seedling_checkbox"
                        android:contentDescription="@string/seedling_widget_description" />
                    <TextView
                        android:id="@+id/task_title_0"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textColor="@color/seedling_ink" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/task_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="3dp">
                    <ImageView
                        android:id="@+id/task_box_1"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:padding="3dp"
                        android:src="@drawable/seedling_checkbox"
                        android:contentDescription="@string/seedling_widget_description" />
                    <TextView
                        android:id="@+id/task_title_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textColor="@color/seedling_ink" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/task_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="3dp">
                    <ImageView
                        android:id="@+id/task_box_2"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:padding="3dp"
                        android:src="@drawable/seedling_checkbox"
                        android:contentDescription="@string/seedling_widget_description" />
                    <TextView
                        android:id="@+id/task_title_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textColor="@color/seedling_ink" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/task_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="3dp">
                    <ImageView
                        android:id="@+id/task_box_3"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:padding="3dp"
                        android:src="@drawable/seedling_checkbox"
                        android:contentDescription="@string/seedling_widget_description" />
                    <TextView
                        android:id="@+id/task_title_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textColor="@color/seedling_ink" />
                </LinearLayout>
        <TextView
            android:id="@+id/tasks_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="All done"
            android:textSize="12sp"
            android:textColor="@color/seedling_faint" />
        <TextView
            android:id="@+id/tasks_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textSize="11sp"
            android:textColor="@color/seedling_faint" />
    </LinearLayout>
</LinearLayout>
