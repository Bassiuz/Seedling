<?xml version="1.0" encoding="utf-8"?>
<!-- Four wide, two high: the day's appointments beside what is left to do.
     Padded to almost nothing on purpose — what makes a glance useful is how
     much of the day fits, not how comfortable the margins are.

     RemoteViews cannot loop, so every row exists here and the provider hides
     the ones it does not need. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/seedling_widget_background"
    android:padding="4dp">

